LOCAL_MONGO_DB=mongodb://localhost:27017/gully-fame?replicaSet=rs0
PORT=9110
JWTSECRET=your_jwt_secret
MASTER_OTP_LOGIN=1234

# Master OTP — always accepted while MASTER_OTP_ENABLED=true (for testing).
# Set MASTER_OTP_ENABLED=false before going live.
MASTER_OTP_ENABLED=true

# Twilio OTP (Console → Account Info for SID/token).
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# "verify" (recommended, Twilio generates/checks the code and handles India DLT)
# or "sms" (we generate the code and send a plain SMS).
TWILIO_OTP_MODE=verify
# verify mode: Console → Verify → Services
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# sms mode: a Messaging Service SID or a Twilio phone number (one is enough)
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# Used when the app sends a mobile number without countryCode.
DEFAULT_COUNTRY_CODE=+91
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Email (forgot-password OTP). Gmail: turn on 2-Step Verification, then
# Google Account → Security → App passwords → create one for "Mail".
MAIL_USER=yourapp@gmail.com
MAIL_APP_PASSWORD=abcd efgh ijkl mnop
MAIL_FROM_NAME=Gully Fame
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
PASSWORD_RESET_OTP_EXPIRY_SECONDS=600

BUCKET=your_s3_bucket_name
REGION=ap-south-1
ACCESSKEY=your_aws_access_key_id
SECRETACCESSKEY=your_aws_secret_access_key

REDIS_URL=redis://localhost:6379

OPENAI_API_KEY=your_openai_api_key

# Firebase push notifications (optional — push is skipped if neither is set).
# Either the service-account JSON as a single line, or a path to the file.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Server-side video export (used by ExportService when the on-device editor's
# export fails). Requires the `ffmpeg` binary installed on this server.
# Optional: path to a .ttf font file, needed only if reels use text overlays.
# FFMPEG_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Razorpay (wallet recharge). Get keys from Razorpay Dashboard → Account & Settings → API Keys.
# Use rzp_test_* keys for development and rzp_live_* in production.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret you set when creating the webhook (Dashboard → Settings → Webhooks).
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR
# Allowed recharge range in rupees (1 rupee = 1 wallet coin).
WALLET_MIN_RECHARGE=1
WALLET_MAX_RECHARGE=100000

# Seed script (node scripts/seed.js) — default test accounts for a fresh DB.
SEED_ADMIN_EMAIL=admin@gullyfame.com
SEED_ADMIN_PASSWORD=change_me_strong_password
SEED_USER_MOBILE=9999999999
