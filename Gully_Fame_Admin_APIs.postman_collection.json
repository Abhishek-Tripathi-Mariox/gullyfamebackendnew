                {
                  "key": "splashTitle",
                  "value": "Welcome to Gully Fame",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/branding",
              "host": ["{{base_url}}"],
              "path": ["admin", "branding"]
            }
          }
        },
        {
          "name": "Update App Branding (Splash Screen)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "splashImage",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "splashTitle",
                  "value": "Welcome to Gully Fame",
                  "type": "text"
                },
                {
                  "key": "splashSubtitle",
                  "value": "Showcase your talent and compete with the best!",
                  "type": "text"
                },
                {
                  "key": "splashButtonText",
                  "value": "Get Started",
                  "type": "text"
                },
                {
                  "key": "showOverlay",
                  "value": "true",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/admin/branding",
              "host": ["{{base_url}}"],
              "path": ["admin", "branding"]
            }
          }
        }
      ]
