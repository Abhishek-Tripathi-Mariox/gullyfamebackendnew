{
  "info": {
    "name": "Gully Fame Admin APIs",
    "description": "Complete API collection for Gully Fame Admin Panel\n\nBase URL: http://localhost:3552/v1/api\n\nFeatures:\n- Admin Authentication\n- App Branding (Logo & Splash Screen)\n- Home Banners Management\n- Categories Management\n- Static Content Management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  var jsonData = pm.response.json();",
                  "  if (jsonData.rCode === 1) {",
                  "    pm.environment.set('token', jsonData.rData.token);",
                  "    pm.test('Admin login successful', function () {",
                  "      pm.expect(jsonData.msg).to.eql('login_success');",
                  "    });",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@gullyfame.com\",\n  \"password\": \"admin123\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/admin/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "admin", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "App Branding",
      "item": [
        {
          "name": "Get App Branding",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/branding",
              "host": ["{{base_url}}"],
              "path": ["admin", "branding"]
            }
          }
        },
        {
          "name": "Update App Branding (Logo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "logo",
                  "type": "file",
                  "src": []
